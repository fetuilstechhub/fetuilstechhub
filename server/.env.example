PORT=8787
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=
# Email: providers are tried in this order; the next one is the backup if one fails.
EMAIL_PROVIDERS=sendbyte,resend
SENDBYTE_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=FETUILS TechHub <noreply@fetuils.ng>
CONTACT_TO_EMAIL=fetuilstechhub@gmail.com
FRONTEND_URL=https://fetuils.ng
# Leave unset for bank transfers via WhatsApp. Set to paystack once Paystack is live
# (and set VITE_PAYMENT_MODE=paystack on the frontend, plus PAYSTACK_SECRET_KEY above).
PAYMENT_MODE=
# Staff PIN for the door scanner and payments page, at least 6 characters
STAFF_PIN=
# PIN for the admin at /admin, at least 8 characters and different from STAFF_PIN
ADMIN_PIN=
# Optional: extra sites allowed to call the API, comma separated
ALLOWED_ORIGINS=
